                        ("main.py", "# The fixture\'s player printer: prints red bots while it can, and logs the\n# team\'s cap so a change in Q24\'s arithmetic moves the transcript.\nwhile True:\n    try:\n        print(\"red\")\n    except ValueError:\n        log(\"cannot print\", len(see()))\n        wait(5)\n"),
                    ],
