                deployment: "red",
                bundle: (
                    files: [
                        ("main.py", "# The fixture\'s second red program, deployed mid-match (Q11): every bot on\n# the color takes it at its next boundary. It stops hauling and stands\n# guard, attacking anything of another team it can see.\nclass Guard:\n    def __init__(self):\n        self.hits = 0\n\n    def target(self):\n        mine = me().team\n        for m in see():\n            if m.team != mine:\n                return m\n        return None\n\nguard = Guard()\nlog(\"guard online\", me().name)\nwhile True:\n    t = guard.target()\n    if t is None:\n        try:\n            move(\"w\")\n        except ValueError:\n            wait(3)\n        continue\n    try:\n        attack(t.id)\n        guard.hits += 1\n        log(\"attacked\", t.id, \"hits\", guard.hits)\n    except ValueError:\n        try:\n            move_to(t.pos[0], t.pos[1])\n        except ValueError:\n            wait(1)\n"),
                    ],
                ),
            ),
        ),
