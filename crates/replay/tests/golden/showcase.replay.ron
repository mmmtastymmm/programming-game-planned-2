(
    map: "# The first map: two teams, mirrored across the centre. Terrain is one\n# character per tile, one row per line; the first row is the north edge and\n# y runs north, with (0, 0) at the centre (docs/03), so this 24 by 16 map\n# runs from (-12, -8) at the south-west to (11, 7) at the north-east:\n#   .  ground    o  ground with a deposit    #  rock    ~  water\n# Every deposit takes [deposit_default] unless [[deposit]] overrides it.\n# This file is part of a replay\'s inputs and is hashed into its identity.\n\nname = \"first\"\n# starting ticks per real second, one of data/world.toml\'s speed steps\nspeed = 10\nwidth = 24\nheight = 16\n\nground_water = 2\nterrain = \"\"\"\n........................\n..o.........##..........\n..o.........##......~~..\n............##......~~..\n........................\n....##..................\n....##.......oo.........\n.............oo.........\n.........oo.............\n.........oo.......##....\n..................##....\n........................\n..~~......##............\n..~~......##.........o..\n.....................o..\n........................\n\"\"\"\n\n[deposit_default]\ncap = 500\nregrowth = 1\namount = 500\n\n[[team]]\nstart = [-9, 4]\n\n[[team]]\nstart = [8, -5]\n\n[[spring]]\nat = [-10, -6]\nrate = \"0.1\"\nhead = 4\n\n[[sink]]\nat = [-9, -6]\nrate = \"0.05\"\nsill = \"3.5\"\n",
    commands: [
        (
            tick: 0,
            sender: (0),
            seq: 0,
            kind: Deploy(
                deployment: "printer",
                bundle: (
                    files: [
                        ("main.py", "# The fixture\'s player printer: printers print by themselves (Q42), so it\n# logs its print\'s countdown and how many machines its team sees — own and\n# rival, bots and buildings — so a change in the printing rule moves the\n# transcript.\nwhile True:\n    log(\"printing\", me().printing, \"sees\", len(see()))\n    wait(5)\n"),
                        ("on_dying.py", ""),
                        ("on_fault.py", ""),
                        ("on_low_power.py", "# The fixture\'s low-power hook (Q62, Q63): walk toward the nearest powered\n# building of the team that holds charge, recharge until nearly full, and\n# let the bot\'s program go on from where it was. It counts its steps, so\n# a bot that cannot get there gives up long before the hook\'s budget does.\ndef on_low_power():\n    tries = 0\n    while tries < 30 and me().charge < 90:\n        tries += 1\n        home = None\n        for m in see():\n            if m.team == me().team and m.kind == \"building\" and m.model != \"site\":\n                if m.powered and m.charge >= 10:\n                    home = m.pos\n                    break\n        if home is None:\n            return\n        here = me().pos\n        if abs(home[0] - here[0]) + abs(home[1] - here[1]) == 1:\n            try:\n                recharge()\n                log(\"recharged to\", me().charge)\n            except ValueError:\n                return\n        else:\n            try:\n                move_to(home[0], home[1])\n            except ValueError:\n                wait(1)\n"),
                    ],
                ),
            ),
        ),
        (
            tick: 0,
            sender: (0),
            seq: 1,
            kind: Deploy(
                deployment: "bot",
                bundle: (
                    files: [
                        ("main.py", "# The fixture\'s first bot program: haul ore from the nearest deposit into\n# the team\'s building plans, one at a time — a charger, a pylon and a\n# printer, whose price rises with the team\'s printers (Q42) — building the\n# site when there is none, lay the team\'s planned wire on the way (Q62),\n# and keep a tally that a redeploy will throw away. It wears its job as its\n# color (Q43): orange while hauling to the site, cyan while fetching ore.\n# The low-power hook beside it (interrupts/on_low_power.py) takes a bot\n# off to recharge, and this loop then goes on where it was (Q63).\nsteps = 0\nCAPACITY = 10\n# The team\'s first bot hauls nothing: it paces a lane beside the deposit,\n# which empties a battery about as fast as a bot can, so that inside the\n# fixture\'s few hundred ticks one bot falls to low power, runs the hook,\n# walks back to recharge and returns. The id is the first a printer on\n# this map gives a bot, and the lane is two tiles of its ground.\nRUNNER = 3\nLANE = (-8, 6)\n# Before it paces, the runner works the ground east of the lane (Q65), a\n# step of this list at a time: it digs a tile down a level and fills the\n# one beside it up a level with that earth, climbs onto the filled tile\n# and moves off it onto the dug one, a drop of two levels and so a fall,\n# and then mines a rock away. And once, pacing, it bonks a bot that has\n# stopped to pick at the lane\'s west end.\nCREW = [\n    (\"go\", -3, 6),\n    (\"dig\", -3, 7),\n    (\"go\", -2, 6),\n    (\"fill\", -2, 7),\n    (\"move\", \"n\"),\n    (\"move\", \"w\"),\n    (\"go\", -1, 6),\n    (\"mine\", 0, 6),\n]\nrunner = {\"stage\": 0, \"bonked\": False}\n# The ninth bot the team\'s first printer prints digs (Q65): it fills up\n# with ore like any other, and from then on carries out the\n# team\'s ground plans, standing west of each, and places and fills the\n# site of a building plan beside it — all of it south of the base, by the\n# lake, so that it leaves the base\'s own sites to the others.\nDIGGER = 25\n\n\ndef crew():\n    step = CREW[runner[\"stage\"]]\n    here = me().pos\n    try:\n        if step[0] == \"go\":\n            if (here[0], here[1]) != (step[1], step[2]):\n                move_to(step[1], step[2])\n                return\n        elif step[0] == \"dig\":\n            dig(step[1], step[2])\n        elif step[0] == \"fill\":\n            fill(step[1], step[2])\n        elif step[0] == \"mine\":\n            mine(step[1], step[2])\n        else:\n            move(step[1])\n            log(\"crew moved\", step[1], \"to height\", tile(me().pos[0], me().pos[1]).height)\n    except ValueError:\n        wait(1)\n        return\n    runner[\"stage\"] += 1\n    log(\"crew\", step[0], \"done, health\", me().health)\n\n\ndef bonk():\n    # At the lane\'s west end with pace: a bot standing on the tile beyond,\n    # picking, is bonked a tile onward, once.\n    west = (LANE[0] - 1, LANE[1])\n    for m in see():\n        if m.kind == \"bot\" and m.pos == west and m.busy == \"pick\":\n            try:\n                move(\"w\")\n            except ValueError:\n                return False\n            # It worked if the tile is empty now: a bot that moved off\n            # before the bonk landed is tried again.\n            runner[\"bonked\"] = True\n            for after in see():\n                if after.pos == west:\n                    runner[\"bonked\"] = False\n            log(\"bonked\", m.id, runner[\"bonked\"])\n            return True\n    return False\n\n\ndef pace():\n    here = me().pos\n    if runner[\"stage\"] < len(CREW):\n        crew()\n        return\n    if not runner[\"bonked\"] and (here[0], here[1]) == LANE and me().pace > 0:\n        if bonk():\n            return\n    if here[1] != LANE[1] or here[0] < LANE[0] or here[0] > LANE[0] + 1:\n        try:\n            move_to(LANE[0], LANE[1])\n        except ValueError:\n            wait(1)\n        return\n    try:\n        move(\"e\" if here[0] == LANE[0] else \"w\")\n    except ValueError:\n        wait(1)\n\n\ndef deposit():\n    for t in tiles(-30, -30, 30, 30):\n        if t.deposit is not None and t.deposit[\"ore\"] > 0:\n            return (t.x, t.y)\n    return None\n\n\ndef site():\n    # The printer first: it is the dearest, and the fixture wants it up\n    # and printing while there are still ticks to see it take its turn.\n    planned = plans(\"building\")\n    for p in planned:\n        if p[2] == \"printer\":\n            return (p[0], p[1])\n    for p in planned:\n        return (p[0], p[1])\n    for m in see():\n        if m.team == me().team and m.model == \"site\":\n            return (m.pos[0], m.pos[1])\n    return None\n\n\ndef wire_plan():\n    for p in plans(\"wire\"):\n        if p[2]:\n            return (p[0], p[1])\n    return None\n\n\ndef adjacent(p):\n    here = me().pos\n    return abs(p[0] - here[0]) + abs(p[1] - here[1]) == 1\n\n\ndef step_off():\n    for d in [\"n\", \"e\", \"s\", \"w\"]:\n        try:\n            move(d)\n            return\n        except ValueError:\n            pass\n    wait(1)\n\n\ndef lakeside(p):\n    return p[1] < 0 and adjacent(p)\n\n\ndef dig_step():\n    for p in plans(\"building\"):\n        if lakeside((p[0], p[1])):\n            try:\n                build(p[2], p[0], p[1])\n                log(\"lakeside site\")\n            except ValueError:\n                wait(1)\n            return\n    for m in see():\n        if m.team == me().team and m.model == \"site\" and lakeside(m.pos):\n            try:\n                drop(\"ore\")\n                log(\"lakeside filled\")\n            except ValueError:\n                wait(1)\n            return\n    for p in plans(\"ground\"):\n        here = me().pos\n        if (here[0], here[1]) == (p[0] - 1, p[1]):\n            try:\n                dig(p[0], p[1])\n                log(\"dug\", p[0], p[1], \"to\", tile(p[0], p[1]).height)\n            except ValueError:\n                wait(1)\n        else:\n            try:\n                move_to(p[0] - 1, p[1])\n            except ValueError:\n                wait(1)\n        return\n    wait(1)\n\n\nwhile True:\n    if me().id == RUNNER:\n        pace()\n        continue\n    if me().id == DIGGER and (me().load[\"ore\"] >= CAPACITY or me().load[\"earth\"] > 0):\n        dig_step()\n        continue\n    full = me().load[\"ore\"] >= CAPACITY\n    job = \"orange\" if full else \"cyan\"\n    if me().color != job:\n        set_color(job)\n    wiring = wire_plan() if full else None\n    target = wiring or (site() if full else deposit())\n    if target is None:\n        wait(5)\n        continue\n    here = me().pos\n    if (here[0], here[1]) == target:\n        step_off()\n        continue\n    if adjacent(target):\n        if wiring is not None:\n            try:\n                wire(target[0], target[1])\n                log(\"wired\")\n            except ValueError:\n                wait(1)\n        elif full:\n            for p in plans(\"building\"):\n                if (p[0], p[1]) == target:\n                    try:\n                        build(p[2], p[0], p[1])\n                        log(\"site placed\")\n                    except ValueError:\n                        pass\n            try:\n                drop(\"ore\")\n                log(\"dropped\")\n            except ValueError:\n                wait(1)\n        else:\n            try:\n                pick(\"ore\")\n                log(\"picked\", me().load[\"ore\"])\n            except ValueError:\n                wait(1)\n        continue\n    try:\n        move_to(target[0], target[1])\n        steps += 1\n    except ValueError:\n        wait(2)\n    if steps % 4 == 0:\n        log(\"steps\", steps, \"sees\", len(see()), \"hears\", len(hear()))\n"),
                        ("on_dying.py", ""),
                        ("on_fault.py", ""),
                        ("on_low_power.py", "# The fixture\'s low-power hook (Q62, Q63): walk toward the nearest powered\n# building of the team that holds charge, recharge until nearly full, and\n# let the bot\'s program go on from where it was. It counts its steps, so\n# a bot that cannot get there gives up long before the hook\'s budget does.\ndef on_low_power():\n    tries = 0\n    while tries < 30 and me().charge < 90:\n        tries += 1\n        home = None\n        for m in see():\n            if m.team == me().team and m.kind == \"building\" and m.model != \"site\":\n                if m.powered and m.charge >= 10:\n                    home = m.pos\n                    break\n        if home is None:\n            return\n        here = me().pos\n        if abs(home[0] - here[0]) + abs(home[1] - here[1]) == 1:\n            try:\n                recharge()\n                log(\"recharged to\", me().charge)\n            except ValueError:\n                return\n        else:\n            try:\n                move_to(home[0], home[1])\n            except ValueError:\n                wait(1)\n"),
                    ],
                ),
            ),
        ),
