            kind: Deploy(
                deployment: "spout",
                bundle: (
                    files: [
                        ("main.py", "# The fixture\'s player spout (Q67): it pours east while the tile east of\n# it is a hollow — lower ground than its own — holding less than most of\n# a level, and nowhere otherwise, so the hollow fills and does not run\n# over.\nFULL = 0.8\nwhile True:\n    here = me().pos\n    mine = tile(here[0], here[1])\n    east = tile(here[0] + 1, here[1])\n    if east is not None and east.height < mine.height and east.water < FULL:\n        if me().pouring != \"e\":\n            pour(\"e\")\n            log(\"pouring\", me().pouring)\n    elif me().pouring is not None:\n        pour(None)\n        log(\"pouring\", me().pouring)\n    wait(1)\n"),
                        ("on_dying.py", ""),
                        ("on_fault.py", ""),
                        ("on_low_power.py", "# The fixture\'s low-power hook (Q62, Q63): walk toward the nearest powered\n# building of the team that holds charge, recharge until nearly full, and\n# let the bot\'s program go on from where it was. It counts its steps, so\n# a bot that cannot get there gives up long before the hook\'s budget does.\ndef on_low_power():\n    tries = 0\n    while tries < 30 and me().charge < 90:\n        tries += 1\n        home = None\n        for m in see():\n            if m.team == me().team and m.kind == \"building\" and m.model != \"site\":\n                if m.powered and m.charge >= 10:\n                    home = m.pos\n                    break\n        if home is None:\n            return\n        here = me().pos\n        if abs(home[0] - here[0]) + abs(home[1] - here[1]) == 1:\n            try:\n                recharge()\n                log(\"recharged to\", me().charge)\n            except ValueError:\n                return\n        else:\n            try:\n                move_to(home[0], home[1])\n            except ValueError:\n                wait(1)\n"),
                    ],
                ),
            ),
        ),
        (
            tick: 386,
            sender: (0),
            seq: 0,
            kind: Deploy(
                deployment: "bot",
                bundle: (
                    files: [
                        ("main.py", "# The fixture\'s waterworks program (Q67), deployed to `bot` once the\n# planned printer\'s site is full and the haulers have nothing left to\n# haul to. In the ticks left before the guards take over, the bots lay a\n# line of wire south from the base, build a tank at its end, a pump west\n# of the tank, beside the flooded hollow, and a spout two tiles east of\n# it, join the spout to the tank with a tile of wire and of pipe, and dig\n# the hollow the spout pours into. Each bot has one of the three sites as\n# its own and helps with the others once its own is full. The digger\n# goes on as it was, and the low-power hook is the one bot.py had.\n#\n# A bot has two hundred cost units a tick (docs/01), so a hauler\'s turn\n# of the loop below is written to fit one step in them: what a bot is and\n# where it works are read once, and it walks no list of machines or\n# tiles.\nCAPACITY = 10\nORE = (-10, 5)\n# Each site, and the tile north of it a bot stands on to build and fill\n# it: a row of tiles a tile north of the sites\', so that no bot waits on\n# a tile something is planned for.\nTANK = (-9, -2)\nPUMP = (-10, -2)\nSPOUT = (-7, -2)\nSITES = [TANK, PUMP, SPOUT]\n# The tile between the tank and the spout, which takes a wire and a pipe,\n# and the hollow east of the spout.\nLINE = (-8, -2)\nHOLLOW = (-6, -2)\n# The way south: the planned printer and the rocks east of it stand\n# between the base and the sites, so a bot north of them makes first for\n# the gap to their west.\nGAP = (-10, 0)\nME = me().id\n# The ninth bot the first printer printed digs, as in bot.py; the bot\n# that lays the wire down the column from the base; and the one that\n# lays the line\'s wire and pipe and then digs the hollow.\nDIGGER = ME == 25\nWIRER = ME == 5\nLINER = ME == 11\nHOME = {3: SPOUT, 5: PUMP, 8: PUMP, 11: SPOUT, 14: SPOUT, 23: PUMP}.get(ME, TANK)\nstate = {\"deliver\": me().load[\"ore\"] >= CAPACITY, \"lines\": WIRER or LINER}\n\n\ndef wants(p):\n    # The model planned on `p`, or \"site\" for its site while that is\n    # short of ore, or None once it is full or built.\n    t = tile(p[0], p[1])\n    kind = t.plans[\"building\"]\n    if kind is not None:\n        return kind\n    b = t.building\n    if b is not None and b.model == \"site\" and b.busy != \"build\":\n        return \"site\"\n    return None\n\n\ndef toward(pos, x, y):\n    # A step toward (x, y); southbound, by way of the gap from north of it.\n    try:\n        if y <= 0 and pos[1] > 0 and pos[0] < -6:\n            move_to(GAP[0], GAP[1])\n        else:\n            move_to(x, y)\n    except ValueError:\n        wait(1)\n\n\ndef haul(pos, ore):\n    if ore >= CAPACITY:\n        state[\"deliver\"] = True\n    elif ore <= 0:\n        state[\"deliver\"] = False\n    target = HOME\n    kind = wants(target)\n    if kind is None:\n        for p in SITES:\n            kind = wants(p)\n            if kind is not None:\n                target = p\n                break\n    if kind is None:\n        wait(5)\n        return\n    if not state[\"deliver\"]:\n        if abs(ORE[0] - pos[0]) + abs(ORE[1] - pos[1]) == 1:\n            try:\n                pick(\"ore\")\n            except ValueError:\n                wait(1)\n        else:\n            toward(pos, ORE[0], ORE[1])\n        return\n    if pos[0] != target[0] or pos[1] != target[1] + 1:\n        toward(pos, target[0], target[1] + 1)\n        return\n    try:\n        if kind == \"site\":\n            drop(\"ore\")\n            log(\"water dropped, left\", me().load[\"ore\"])\n        else:\n            build(kind, target[0], target[1])\n            log(\"water site\", kind)\n    except ValueError:\n        wait(1)\n\n\ndef wire_column(pos):\n    # The wire plans in the tank\'s column, north to south, each laid from\n    # the tile west of it.\n    for p in plans(\"wire\"):\n        if p[0] == TANK[0]:\n            if pos[0] == p[0] - 1 and pos[1] == p[1]:\n                try:\n                    wire(p[0], p[1])\n                    log(\"water wired\", p[1])\n                except ValueError:\n                    wait(1)\n            else:\n                toward(pos, p[0] - 1, p[1])\n            return\n    state[\"lines\"] = False\n\n\ndef line(pos):\n    # The line\'s wire, then its pipe, from the tile north of it; then\n    # what is left of the load to a site; then the hollow, from the tile\n    # north of that.\n    plan = tile(LINE[0], LINE[1]).plans\n    if plan[\"wire\"] or plan[\"pipe\"]:\n        if pos[0] != LINE[0] or pos[1] != LINE[1] + 1:\n            toward(pos, LINE[0], LINE[1] + 1)\n            return\n        try:\n            if plan[\"wire\"]:\n                wire(LINE[0], LINE[1])\n            else:\n                pipe(LINE[0], LINE[1])\n            log(\"water line\", tile(LINE[0], LINE[1]).wires, tile(LINE[0], LINE[1]).pipes)\n        except ValueError:\n            wait(1)\n        return\n    if me().load[\"ore\"] > 0:\n        haul(pos, me().load[\"ore\"])\n        return\n    if tile(HOLLOW[0], HOLLOW[1]).height < tile(HOLLOW[0], HOLLOW[1] + 1).height:\n        state[\"lines\"] = False\n        return\n    if pos[0] != HOLLOW[0] or pos[1] != HOLLOW[1] + 1:\n        toward(pos, HOLLOW[0], HOLLOW[1] + 1)\n        return\n    try:\n        dig(HOLLOW[0], HOLLOW[1])\n        log(\"water dug\", tile(HOLLOW[0], HOLLOW[1]).height)\n    except ValueError:\n        wait(1)\n\n\ndef lakeside(p):\n    h = me().pos\n    return p[1] < 0 and abs(p[0] - h[0]) + abs(p[1] - h[1]) == 1\n\n\ndef dig_step():\n    # bot.py\'s, as it was.\n    for p in plans(\"building\"):\n        if lakeside((p[0], p[1])):\n            try:\n                build(p[2], p[0], p[1])\n                log(\"lakeside site\")\n            except ValueError:\n                wait(1)\n            return\n    for m in see():\n        if m.team == me().team and m.model == \"site\" and lakeside(m.pos):\n            try:\n                drop(\"ore\")\n                log(\"lakeside filled\")\n            except ValueError:\n                wait(1)\n            return\n    for p in plans(\"ground\"):\n        h = me().pos\n        if (h[0], h[1]) == (p[0] - 1, p[1]):\n            try:\n                dig(p[0], p[1])\n                log(\"dug\", p[0], p[1], \"to\", tile(p[0], p[1]).height)\n            except ValueError:\n                wait(1)\n        else:\n            try:\n                move_to(p[0] - 1, p[1])\n            except ValueError:\n                wait(1)\n        return\n    wait(1)\n\n\nwhile True:\n    if DIGGER:\n        dig_step()\n        continue\n    m = me()\n    if state[\"lines\"]:\n        if WIRER:\n            wire_column(m.pos)\n        else:\n            line(m.pos)\n        continue\n    haul(m.pos, m.load[\"ore\"])\n"),
                        ("on_dying.py", ""),
                        ("on_fault.py", ""),
                        ("on_low_power.py", "# The fixture\'s low-power hook (Q62, Q63): walk toward the nearest powered\n# building of the team that holds charge, recharge until nearly full, and\n# let the bot\'s program go on from where it was. It counts its steps, so\n# a bot that cannot get there gives up long before the hook\'s budget does.\ndef on_low_power():\n    tries = 0\n    while tries < 30 and me().charge < 90:\n        tries += 1\n        home = None\n        for m in see():\n            if m.team == me().team and m.kind == \"building\" and m.model != \"site\":\n                if m.powered and m.charge >= 10:\n                    home = m.pos\n                    break\n        if home is None:\n            return\n        here = me().pos\n        if abs(home[0] - here[0]) + abs(home[1] - here[1]) == 1:\n            try:\n                recharge()\n                log(\"recharged to\", me().charge)\n            except ValueError:\n                return\n        else:\n            try:\n                move_to(home[0], home[1])\n            except ValueError:\n                wait(1)\n"),
                    ],
                ),
            ),
        ),
