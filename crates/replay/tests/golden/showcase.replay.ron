(
    map: "# The first map: two teams, mirrored across the centre. Terrain is one\n# character per tile, one row per line; the first row is the north edge and\n# y runs north, with (0, 0) at the centre (docs/03), so this 24 by 16 map\n# runs from (-12, -8) at the south-west to (11, 7) at the north-east:\n#   .  ground    o  ground with a deposit    #  rock    ~  water\n# Every deposit takes [deposit_default] unless [[deposit]] overrides it.\n# This file is part of a replay\'s inputs and is hashed into its identity.\n\nname = \"first\"\n# starting ticks per real second, one of data/world.toml\'s speed steps\nspeed = 10\nwidth = 24\nheight = 16\n\nterrain = \"\"\"\n........................\n..o.........##..........\n..o.........##......~~..\n............##......~~..\n........................\n....##..................\n....##.......oo.........\n.............oo.........\n.........oo.............\n.........oo.......##....\n..................##....\n........................\n..~~......##............\n..~~......##.........o..\n.....................o..\n........................\n\"\"\"\n\n[deposit_default]\ncap = 500\nregrowth = 1\namount = 500\n\n[[team]]\nstart = [-9, 4]\n\n[[team]]\nstart = [8, -5]\n",
    commands: [
