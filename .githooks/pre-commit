#!/usr/bin/env bash
# Fast doc gate: runs the docs half of CI before every commit that touches a .md
# (link resolution, then mermaid parsing).
#
# Install (one command, per clone):   scripts/install-hooks.sh
# Skip once:                          git commit --no-verify
#
# It checks the STAGED content, not the working tree — it extracts the index to
# a temp dir and runs there. So a half-staged fix can't pass on the strength of
# unstaged edits, and unstaged breakage can't block a clean commit.
#
# Only the docs half of CI runs here (seconds). The Rust half is too slow for a
# commit hook; CI covers it.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Nothing staged → nothing to check. NO --diff-filter: a commit that only
# DELETES markdown is the change most likely to break links, and ACMR excluded
# exactly that. No '*.md' pathspec either: deleting or renaming a source file a
# doc links to (CLAUDE.md cites crates/sim/src/rng.rs) breaks links just as
# thoroughly, and used not to trigger the hook at all.
if ! git diff --cached --quiet --name-only 2>/dev/null; then
  :
else
  exit 0
fi

# Size gate first: cheap, and it is the one failure that cannot be fixed later
# without rewriting history. Lives in its own script so it can be tested — as an
# inline loop it silently aborted every commit (see that file's header).
if ! scripts/check-staged-size.sh; then
  echo "pre-commit: aborted." >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found, skipping the doc checks (CI still gates them)" >&2
  exit 0
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# Materialize the WHOLE staged tree, preserving paths — not just the .md files.
# The predecessor's version extracted `*.md` only, which quietly turns every
# doc→source link into a false "missing file": CLAUDE.md links
# crates/sim/src/rng.rs, that path is absent from a markdown-only extraction,
# and the hook fails on a tree CI passes. A hook that disagrees with CI gets
# bypassed, and then it is not a gate.
git checkout-index -a --prefix="$TMP/"

# No "docs/ is missing, never mind" escape here. There used to be one, and
# because checkout-index materializes the WHOLE index rather than the changed
# files, it fired only when the commit left zero tracked files under docs/ —
# i.e. exactly when the corpus was being deleted. The hook then exited 0 having
# run nothing at all, including the CLAUDE.md and README.md link checks, which
# are scanned from the repo root and have nothing to do with docs/. The checks
# below already report a missing corpus accurately, so they get to run and say
# so.
if ! scripts/ci.sh docs "$TMP"; then
  echo >&2
  echo "pre-commit: doc checks failed on the STAGED content — commit aborted." >&2
  echo "            fix it, or 'git commit --no-verify' to bypass." >&2
  exit 1
fi
